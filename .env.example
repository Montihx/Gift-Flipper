# Скопируйте в .env и заполните. .env не коммитится (AGENTS.md §4.2).
# Секреты — только здесь или в data/ с правами 600.

# Безопасность. false запрещён до разрешения Этапа 7 (настройки не загрузятся).
DRY_RUN=true

# Хранилища
DATABASE_URL=postgresql+asyncpg://giftflipper:giftflipper@localhost:5432/giftflipper
REDIS_URL=redis://localhost:6379/0
# DATA_DIR=./data

# Telegram-бот (Этап 5)
BOT_TOKEN=
OWNER_CHAT_ID=
# https-адрес Mini App (кнопка в /start и Menu Button)
WEBAPP_URL=
# Час итога дня, UTC
DAILY_SUMMARY_HOUR_UTC=18

# Telethon-сессия владельца для initData маркетов (Этап 2, только на ПК владельца, D-016)
TG_API_ID=
TG_API_HASH=
TG_SESSION_NAME=owner

# Бюджет запросов к маркетам (D-008)
MARKET_MIN_INTERVAL_S=1.0
LISTINGS_POLL_INTERVAL_S=5.0
REQUEST_TIMEOUT_S=10.0
BACKOFF_BASE_S=2.0
BACKOFF_MAX_S=300.0

# Живые запросы на чтение (Этап 2.8). Ставит владелец после просмотра `--plan`.
# LIVE_READS_APPROVED=yes

LOG_LEVEL=INFO
